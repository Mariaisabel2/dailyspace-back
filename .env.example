# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Base de Datos PostgreSQL (Supabase / Pooler)
DATABASE_URL="postgresql://usuario:password@localhost:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@localhost:5432/postgres"

# Autenticación JWT
JWT_SECRET="tu_clave_secreta_super_segura_aqui"
JWT_EXPIRES_IN="7d"

# CORS (URL del frontend en Vercel o localhost)
FRONTEND_URL="http://localhost:3000"
